  --color-accent: #b8f23f;
  --color-sky: #6ec8ff;
  --color-warn: #ffb02e;
  --color-crit: #ff4d6a;
}

html,
body {
  height: 100%;
}

html {
  color-scheme: dark;
}

body {
  background-color: var(--deep);
  color: var(--mist);
  font-family: var(--font-dm-sans), ui-sans-serif, system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
