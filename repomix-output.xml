const mockDatabase = {
  'Facility A': {
    'Morning Crew': { kpi: '142.1', overtime: [10, 12, 9, 15, 11], trend: [130, 135, 140, 142, 138], issue: "Morning crew is operating at peak efficiency with minimal overtime.", status: "Optimal" },
