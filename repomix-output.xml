      const apply = () => setIsTall(mq.matches);
      apply();
      mq.addEventListener('change', apply);
      return () => mq.removeEventListener('change', apply);
    }, []);

    // Esc closes whatever is open
    useEffect(() => {
      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          setIsInfoOpen(false);
          setIsPanelOpen(false);
        }
