@import "tailwindcss";

/* ------------------------------------------------------------------
   HUMAN UTILIZATION  //  "Deep Canopy" DNA
   Background : #04100b  (deep pine-black, luminance ~0.4%  -> well under 10%)
   Accent     : #b8f23f  "Vital Lime"  (workforce vitality / living signal)
   Text       : #d9ead6  soft sage-mist (never pure white)
   Status     : lime = Optimal, amber = Warning, red = Critical
------------------------------------------------------------------- */

/* Plain CSS variables: used by the map, markers and inline styles */
:root {
  --deep: #04100b;
  --surface: #0a1812;
  --surface-2: #0f2119;
  --line: rgba(217, 234, 214, 0.12);
  --mist: #d9ead6;
  --moss: #7e9686;
  --accent: #b8f23f;
  --sky: #6ec8ff;
  --warn: #ffb02e;
  --crit: #ff4d6a;
}

/* Tailwind v4 tokens (this is what generates bg-deep, text-accent, etc.) */
@theme inline {
  --font-sans: var(--font-dm-sans), ui-sans-serif, system-ui, sans-serif;
  --font-display: var(--font-bricolage), var(--font-dm-sans), ui-sans-serif, sans-serif;
