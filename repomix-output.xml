<file path="scripts/data_pipeline/sample_data.py">
"""Step 2 - Representative reduction (stratified, seed 42, never df.head()).

If the extract is within MAX_ROWS the full population is retained (no reduction, no information loss).
Otherwise: stratified sampling with >=1 record per stratum (rare strata always survive) and the
remaining budget allocated proportionally (largest-remainder). Stratum = source x facility x team x
status x month. Writes data/quality/sampling_report.md with coverage checks.
"""
import numpy as np
import pandas as pd
from _common import *

STRATA = ["source_system", "facility", "team", "status_label", "period"]
COVERAGE = ["source_system", "facility", "team", "status_label", "record_date"]


def prep(df):
    df = df.copy()
    df["status_label"] = df["node_status"].where(df["node_status"] != "", df["coverage_status"])
    df["period"] = df["record_date"].str.slice(0, 7)
    return df


def reduce(df, max_rows=MAX_ROWS, seed=RANDOM_SEED):
    if len(df) <= max_rows:
        return df.copy(), "full_population_retained"
    key = df[STRATA].astype(str).agg("|".join, axis=1)
    size = key.value_counts().sort_index()
    alloc = pd.Series(1, index=size.index)
    spare = max_rows - len(size)
    if spare < 0:
        raise SystemExit("More strata than allowed rows; coarsen STRATA")
    room = size - 1
    share = room / room.sum() * spare if room.sum() else room * 0
    alloc += np.minimum(np.floor(share).astype(int), room)
    left = max_rows - int(alloc.sum())
    frac = (share - np.floor(share)).where(alloc < size, -1).sort_values(ascending=False, kind="stable")
    for k in frac.index[:max(left, 0)]:
        if alloc[k] < size[k]:
            alloc[k] += 1
    parts = [df[key == k].sample(n=int(alloc[k]), random_state=seed) for k in size.index]
    return pd.concat(parts).sort_index(), "stratified_sample"


def coverage_rows(before, after):
    out = []
    for c in COVERAGE:
        b, a = set(before[c].astype(str)), set(after[c].astype(str))
        out.append((c, len(b), len(a), ", ".join(sorted(b - a)) or "none"))
    return out


def main():
    raw = pd.read_csv(SOURCE_SAMPLE, dtype=str, keep_default_na=False)
    stats = load_stats()
    before = prep(raw)
    after, method = reduce(before)
    after = after.reset_index(drop=True)
    after[SOURCE_COLUMNS].to_csv(SOURCE_SAMPLE, index=False, encoding="utf-8", lineterminator="\n")
    cov = coverage_rows(before, after)
    rare = before[before["status_label"].isin(["Critical"])]
    rare_kept = after[after["status_label"].isin(["Critical"])]
    lines = [
        "# Sampling Report (generated by scripts/data_pipeline/sample_data.py)", "",
        f"- Method: `{method}`", f"- Random seed: {RANDOM_SEED} (used only if reduction is needed)",
        f"- Row limit: {MAX_ROWS:,} rows / {MAX_COLS} columns",
        f"- Original extract: {len(before)} rows x {stats.get('original_column_count', len(SOURCE_COLUMNS))} columns",
        f"- Final source sample: {len(after)} rows x {len(SOURCE_COLUMNS)} columns",
        f"- Rows removed: {len(before) - len(after)}", "",
        "## Coverage checks (distinct values before vs after)", "",
        "| Field | Before | After | Missing after sampling |", "|---|---:|---:|---|",
        *[f"| {c} | {b} | {a} | {m} |" for c, b, a, m in cov], "",
        "## Rare-record preservation", "",
        f"- Critical-status rows (rarest class, ~10% of backend rows by design): {len(rare)} before, {len(rare_kept)} after.",
        "- Every facility x team x status x month stratum keeps at least one record.", "",
        "## Notes", "",
        "- The extract is far below the row limit, so no records were dropped; df.head() is never used.",
        "- UI-only interpolated Last-30-Days / Year-to-Date series are excluded (derived, not source data).",
    ]
    SAMPLING_REPORT.write_text("\n".join(lines) + "\n", "utf-8")
    save_stats({"sampling_method": method, "sample_record_count": len(after),
                "sample_column_count": len(SOURCE_COLUMNS), "rows_removed": len(before) - len(after)})
    print(f"{method}: {len(before)} -> {len(after)} rows")


if __name__ == "__main__":
    main()
</file>

<file path="scripts/data_pipeline/standardize_data.py">
"""Step 3 - Map the source sample to the 20-column canonical schema (long/tidy format)."""
import re
import pandas as pd
from _common import *

STATUS_MAP = {"strained": "warning"}  # backend vocabulary -> UI vocabulary (Optimal/Warning/Critical)
FE_METRICS = [("output_per_hour", "units_per_hour"), ("overtime_hours", "hours")]
BE_METRICS = [("attendance_rate", "ratio"), ("output_per_hour", "units_per_hour"), ("overtime_hours", "hours")]


def slug(s):
    return re.sub(r"[^a-z0-9]+", "_", str(s).lower()).strip("_")


def status(s):
    s = slug(s)
    return STATUS_MAP.get(s, s) or None


def num(v):
    return pd.to_numeric(v, errors="coerce")


def blank(v):
    return None if v in ("", None) else v


def build(src: pd.DataFrame) -> pd.DataFrame:
    recs = []

    def rec(**k):
        base = dict.fromkeys(MANDATORY_COLUMNS)
        base.update(related_entity_id=None, stage=None, latitude=None, longitude=None,
                    is_synthetic=True, data_version=DATA_VERSION)
        base.update(k)
        recs.append(base)

    fe = src[src.source_system == SRC_FE]
    be = src[src.source_system == SRC_BE]

    for _, r in fe.iterrows():
        eid = f"{slug(r.facility)}_{slug(r.team)}"
        for m, unit in FE_METRICS:
            rec(record_type="measurement", observed_at=f"{r.record_date}T00:00:00Z", entity_id=eid,
                entity_name=f"{r.facility} - {r.team}", category=slug(r.team), subcategory=slug(r.facility),
                status=status(r.node_status), metric_name=m, metric_value=num(r[m]), metric_unit=unit,
                source_name=SRC_FE, source_record_id=f"{r.source_row_id}|{m}")
    for _, r in fe.drop_duplicates(["facility", "team"]).iterrows():  # one headline KPI + insight text per node
        rec(record_type="entity", observed_at=None, entity_id=f"{slug(r.facility)}_{slug(r.team)}",
            entity_name=f"{r.facility} - {r.team}", category=slug(r.team), subcategory=slug(r.facility),
            status=status(r.node_status), metric_name="kpi_output_per_hour", metric_value=num(r.node_kpi_output_per_hour),
            metric_unit="units_per_hour", text_value=str(r.node_issue_text)[:MAX_TEXT], source_name=SRC_FE,
            source_record_id=f"FE|{r.facility}|{r.team}|kpi")
    for _, r in be.iterrows():
        for m, unit in BE_METRICS:
            rec(record_type="measurement", observed_at=f"{r.record_date}T00:00:00Z", entity_id=f"shift_{slug(r["shift"])}",
                entity_name=f"{r.team} (all facilities)", category=slug(r.team), subcategory=None,
                status=status(r.coverage_status), metric_name=m, metric_value=num(r[m]), metric_unit=unit,
                source_name=SRC_BE, source_record_id=f"{r.source_row_id}|{m}")

    df = pd.DataFrame(recs, columns=MANDATORY_COLUMNS)
    df["_src"] = (df.source_name != SRC_FE).astype(int)
    df["_ty"] = (df.record_type != "entity").astype(int)
    df = df.sort_values(["_src", "_ty", "entity_id", "observed_at", "metric_name"], na_position="first", kind="stable")
    df = df.drop(columns=["_src", "_ty"]).reset_index(drop=True)
    df["record_id"] = [f"REC-{i + 1:05d}" for i in range(len(df))]
    df["is_synthetic"] = df["is_synthetic"].map({True: "true", False: "false"})
    return df[MANDATORY_COLUMNS]


def to_csv_bytes(df):
    return df.to_csv(index=False, encoding="utf-8", lineterminator="\n", float_format="%.10g").encode("utf-8")


def main():
    src = pd.read_csv(SOURCE_SAMPLE, dtype=str, keep_default_na=False)
    df = build(src)
    CANONICAL.parent.mkdir(parents=True, exist_ok=True)
    CANONICAL.write_bytes(to_csv_bytes(df))
    print(f"Canonical: {len(df)} rows x {len(df.columns)} cols -> {CANONICAL.relative_to(ROOT)}")


if __name__ == "__main__":
    main()
</file>

